{
  "name": "cmdsift-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for @smai-kit/cmdsift and its per-platform binary packages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/smk-h/cmdsift-monorepo"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync-packages": "node ./build/sync-packages.js",
    "prepare-binaries": "node ./build/prepare-binaries.js",
    "update-lock": "node ./build/prepare-binaries.js --update-lock"
  },
  "devDependencies": {
    "@types/node": "^20.8.4"
  }
}
